---
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import { site } from '../../data/site';
---

<footer class="site-footer" data-od-id="site-footer">
  <div class="footer-statement">
    <p class="eyebrow">Keep the conversation going</p>
    <h2>Start with the people.</h2>
  </div>
  <div class="footer-links">
    <a href={`mailto:${site.email}`}>
      <span>Email Joel</span><ExternalLinkIcon class="external-link-icon" />
    </a>
    <ul aria-label="Social profiles">
      {
        site.social.map((profile) => (
          <li>
            <a href={profile.url} target="_blank" rel="noopener noreferrer">
              <>
                <span>{profile.label}</span>
                <ExternalLinkIcon class="external-link-icon" />
              </>
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#main-content">
      <span>Return to top</span><span aria-hidden="true">↑</span>
    </a>
  </div>
  <p class="footer-legal">
    © {new Date().getFullYear()} Joel Rhine · Built under the rhonen name.
  </p>
</footer>
