---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';

const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-od-id="site-header">
  <a
    class="wordmark"
    href="/"
    aria-label="rhonen home"
    data-od-id="site-wordmark"
  >
    <span aria-hidden="true">r/</span>{site.wordmark}
  </a>
  <nav
    class="primary-nav"
    aria-label="Primary navigation"
    data-od-id="site-navigation"
  >
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                currentPath === item.href ||
                currentPath.startsWith(item.href + '/')
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="resume-item">
        <a class="header-resume" href="/files/resume.pdf"
          >Resume <span aria-hidden="true">↓</span></a
        >
      </li>
    </ul>
  </nav>
</header>
