---
import type { CollectionEntry } from 'astro:content';
import {
  formatExperienceMeta,
  getExperienceRailLabel,
} from '../../lib/experienceTimeline';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';

type Props = {
  entries: CollectionEntry<'experience'>[];
  headingLevel?: 2 | 3;
};
const { entries, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<div
  class="timeline-shell"
  data-od-id="experience-timeline"
  data-experience-timeline
  data-timeline-active-index="0"
  data-timeline-reduced-motion="false"
>
  <span
    class="timeline-marker"
    aria-hidden="true"
    data-experience-marker
    data-timeline-active="true"></span>
  <ol class="timeline">
    {
      entries.map((entry, index) => (
        <li
          class:list={['timeline-entry', entry.data.type]}
          data-od-id={`experience-${entry.id}`}
          data-experience-entry
          data-timeline-active={index === 0 ? 'true' : 'false'}
        >
          <div class="timeline-rail" data-experience-rail>
            <span
              class="timeline-rail-label micro"
              data-experience-rail-label
              data-timeline-active={index === 0 ? 'true' : 'false'}
            >
              {getExperienceRailLabel(entry.data, index)}
            </span>
          </div>
          <div class="timeline-copy">
            <p class="timeline-meta eyebrow" data-experience-meta>
              {formatExperienceMeta(entry.data)}
            </p>
            <Heading>{entry.data.title}</Heading>
            <p class="timeline-organization eyebrow">
              {entry.data.organizationUrl ? (
                <a
                  href={entry.data.organizationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-experience-organization
                >
                  <span>{entry.data.organization}</span>
                  <ExternalLinkIcon class="external-link-icon" />
                </a>
              ) : (
                <span data-experience-organization>
                  {entry.data.organization}
                </span>
              )}
            </p>
            <p>{entry.data.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { mountExperienceTimeline } from '../../lib/experienceTimeline';

  const cleanups = new WeakMap();

  document.querySelectorAll('[data-experience-timeline]').forEach((root) => {
    cleanups.get(root)?.();
    cleanups.set(root, mountExperienceTimeline(root));
  });
</script>
