---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entries: CollectionEntry<'experience'>[];
  headingLevel?: 2 | 3;
};
const { entries, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const formatYear = (date: Date) =>
  new Intl.DateTimeFormat('en', { year: 'numeric' }).format(date);
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li>
        <div class="timeline-dates">
          <span>{formatYear(entry.data.startDate)}</span>
          <span>
            {entry.data.endDate ? formatYear(entry.data.endDate) : 'Now'}
          </span>
        </div>
        <div>
          <p class="eyebrow">{entry.data.organization}</p>
          <Heading>{entry.data.title}</Heading>
          <p>{entry.data.summary}</p>
        </div>
      </li>
    ))
  }
</ol>
