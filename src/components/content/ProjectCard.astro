---
import type { CollectionEntry } from 'astro:content';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import ProjectArrowIcon from '../icons/ProjectArrowIcon.astro';
import { getProjectPresentation } from '../../data/projectPresentation';

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const { title, summary, role, tags, links } = project.data;

const presentation = getProjectPresentation(project.id);
const projectHref = `/work/${project.id}/`;
---

<article
  class:list={['project-record', presentation?.categoryClass]}
  data-project-card
  data-od-id={`project-${project.id}`}
>
  <span class="project-index micro" aria-hidden="true">
    {String(project.data.sortOrder ?? 0).padStart(2, '0')}
  </span>
  <div class="project-content">
    <div class="project-title-row" data-project-zone="title">
      <h3><a href={projectHref}>{title}</a></h3>
    </div>
    <div class="project-details" data-project-zone="details">
      <div class="project-description" data-project-zone="description">
        <p class="eyebrow" data-project-landmark="description-label">{role}</p>
        <p data-project-landmark="description-body">{summary}</p>
        <ul class="tag-list" aria-label={`${title} technologies`}>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <div class="project-category" data-project-zone="category">
        <p class="eyebrow" data-project-landmark="category-label">Type</p>
        <strong data-project-landmark="category-value">
          {presentation?.category ?? 'Selected work'}
        </strong>
        {
          links.length > 0 && (
            <ul class="project-category-links" aria-label={`${title} links`}>
              {links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    data-project-landmark="category-link"
                  >
                    <span>{link.compactLabel ?? link.label}</span>
                    <ExternalLinkIcon class="external-link-icon" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    {
      presentation && (
        <>
          <picture
            class="project-media-frame"
            data-project-zone="media"
            style={`--mobile-media-width: ${presentation.mobileImageWidth}; --mobile-media-height: ${presentation.mobileImageHeight};`}
          >
            <source
              media="(max-width: 45rem)"
              srcset={presentation.mobileImage}
            />
            <img
              src={presentation.image}
              width={presentation.imageWidth}
              height={presentation.imageHeight}
              alt={presentation.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="project-caption" data-project-zone="caption">
            <span class="eyebrow">Preview</span>
            <span class="micro">{presentation.caption}</span>
          </div>
        </>
      )
    }
  </div>
  <a
    class="project-arrow"
    href={projectHref}
    aria-label={`Read ${title} project details`}
    data-project-zone="cta"
  >
    <span class="project-arrow-label">View project</span>
    <ProjectArrowIcon class="project-arrow-icon" />
  </a>
</article>
