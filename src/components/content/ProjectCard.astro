---
import type { CollectionEntry } from 'astro:content';

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const { title, summary, role, tags, links } = project.data;
---

<article class="project-card">
  <a
    class="card-link"
    href={`/work/${project.id}/`}
    aria-label={`Read ${title} case study`}
  >
    <span class="card-index" aria-hidden="true"
      >{String(project.data.sortOrder ?? 0).padStart(2, '0')}</span
    >
    <div>
      <p class="eyebrow">{role}</p>
      <h3>{title}</h3>
      <p>{summary}</p>
      <ul class="tag-list" aria-label={`${title} technologies`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
  {
    links[0] && (
      <a class="external-link" href={links[0].url}>
        {links[0].label} ↗
      </a>
    )
  }
</article>
