---
import { getCollection } from 'astro:content';
import ExperienceTimeline from '../components/content/ExperienceTimeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('experience'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
---

<BaseLayout
  title="Experience | Joel Rhine"
  description="Joel Rhine's experience across product engineering, integrations, coffee, and operations."
>
  <header class="page-intro">
    <p class="eyebrow">Experience</p><h1>Built from the work outward.</h1><p>
      Fourteen years in coffee and operations shaped an engineering practice
      focused on integrations, automation, product systems, and useful handoffs.
    </p>
  </header>
  <section class="section"><ExperienceTimeline entries={entries} /></section>
</BaseLayout>
