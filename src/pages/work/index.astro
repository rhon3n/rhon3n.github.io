---
import { getCollection } from 'astro:content';
import ContributionTicker from '../../components/content/ContributionTicker.astro';
import ProjectRail from '../../components/content/ProjectRail.astro';
import { publicGitHubSnapshot } from '../../data/githubSnapshots';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByDate } from '../../lib/content';

const projects = sortByDate(
  (await getCollection('projects')).filter((entry) => !entry.data.draft),
);
const pageSections = [
  { id: 'work-intro', label: 'Introduction' },
  { id: 'work-projects', label: 'Featured projects' },
  { id: 'public-github-activity', label: 'GitHub activity' },
] as const;
---

<BaseLayout
  title="Work | Joel Rhine"
  description="Selected product, engineering, and creative work by Joel Rhine, built around real people and real needs."
  pageSections={pageSections}
>
  <header id="work-intro" class="page-intro work-intro" data-od-id="work-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Products, systems, and tools for people who need something to work.</h1>
    <p>
      I like work with a clear human constraint: a team losing time, a customer
      who cannot find an answer, or a person who needs the right tool to move
      forward.
    </p>
  </header>
  <section
    id="work-projects"
    class="section flush"
    aria-labelledby="projects-heading"
    data-od-id="work-projects"
  >
    <h2 id="projects-heading" class="eyebrow">Featured projects</h2>
    <ProjectRail
      projects={projects}
      railId="work-featured-projects"
      labelledBy="projects-heading"
      regionLabel="Featured projects"
    />
  </section>
  <ContributionTicker {...publicGitHubSnapshot} />
</BaseLayout>
