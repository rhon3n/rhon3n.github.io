---
import { getCollection, render } from 'astro:content';
import ContributionTicker from '../../components/content/ContributionTicker.astro';
import ExternalLinkIcon from '../../components/icons/ExternalLinkIcon.astro';
import { measurePrivateSnapshot } from '../../data/githubSnapshots';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectPresentation } from '../../data/projectPresentation';
import { getPublicationYear } from '../../lib/content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(
    (entry) => !entry.data.draft,
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const presentation = getProjectPresentation(project.id);
const pageSections = [
  { id: 'case-intro', label: 'Introduction' },
  ...(presentation ? [{ id: 'case-media', label: 'Project preview' }] : []),
  { id: 'case-content', label: 'Case study' },
  ...(project.id === 'measure-coffee'
    ? [{ id: 'measure-repository-activity', label: 'Engineering activity' }]
    : []),
  { id: 'case-navigation', label: 'More work' },
] as const;
---

<BaseLayout
  title={`${project.data.title} | Joel Rhine`}
  description={project.data.summary}
  type="article"
  pageSections={pageSections}
>
  <header
    id="case-intro"
    class="case-header"
    data-od-id={`case-${project.id}-intro`}
  >
    <div class="case-coordinate">
      <p class="eyebrow">{project.data.role}</p>
      <div class="case-meta">
        <span>{getPublicationYear(project.data.publishedAt)}</span>
        <span>{project.data.tags.join(' · ')}</span>
      </div>
    </div>
    <div class="case-title">
      {
        project.id === 'measure-coffee' ? (
          <h1 set:html={'measure.<wbr>coffee'} />
        ) : (
          <h1>{project.data.title}</h1>
        )
      }
      <p class="hero-copy">{project.data.summary}</p>
      <div class="actions">
        {
          project.data.links.map((link, index) => (
            <a
              class:list={['button', index === 0 && 'button-primary']}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{link.label}</span>
              <ExternalLinkIcon class="external-link-icon" />
            </a>
          ))
        }
      </div>
    </div>
  </header>
  {
    presentation && (
      <figure
        id="case-media"
        class="case-media"
        data-od-id={`case-${project.id}-media`}
        style={`--mobile-media-width: ${presentation.mobileImageWidth}; --mobile-media-height: ${presentation.mobileImageHeight};`}
      >
        <picture class="case-media-frame">
          <source
            media="(max-width: 45rem)"
            srcset={presentation.mobileImage}
          />
          <img
            src={presentation.image}
            width={presentation.imageWidth}
            height={presentation.imageHeight}
            alt={presentation.alt}
            decoding="async"
          />
        </picture>
        <figcaption>
          <span class="eyebrow">{presentation.category}</span>
          <span class="micro">{presentation.caption}</span>
        </figcaption>
      </figure>
    )
  }
  <article
    id="case-content"
    class="prose case-prose"
    data-od-id={`case-${project.id}-content`}
  >
    <Content />
  </article>
  {
    project.id === 'measure-coffee' && (
      <ContributionTicker {...measurePrivateSnapshot} />
    )
  }
  <nav
    id="case-navigation"
    class="section case-nav"
    aria-label="Work navigation"
    data-od-id="case-navigation"
  >
    <a class="text-action" href="/work/">← All work</a>
  </nav>
</BaseLayout>
