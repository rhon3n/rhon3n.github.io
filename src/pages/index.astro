---
import { getCollection } from 'astro:content';
import ExperienceTimeline from '../components/content/ExperienceTimeline.astro';
import ProjectRail from '../components/content/ProjectRail.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortByDate } from '../lib/content';

const projects = sortByDate(
  (await getCollection('projects')).filter((entry) => !entry.data.draft),
);
const experience = (await getCollection('experience'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const pageSections = [
  { id: 'home-intro', label: 'Introduction' },
  { id: 'home-operating-history', label: 'How I got here' },
  { id: 'home-featured-work', label: 'Featured work' },
  { id: 'home-experience', label: 'Experience' },
  { id: 'home-contact', label: 'Contact' },
] as const;
---

<BaseLayout pageSections={pageSections}>
  <section id="home-intro" class="hero" data-od-id="home-hero">
    <div class="hero-main">
      <p class="eyebrow">Joel Rhine · Software engineer & product builder</p>
      <h1>I BUILD PRODUCTS WITH THE PEOPLE USING THEM IN MIND.</h1>
      <p class="hero-copy">
        Software should serve people, because behind every workflow, automation
        or agent, there is a person needing something done.
      </p>
      <div class="actions">
        <a class="button button-primary" href="/work/">See selected work</a>
        <a class="text-action" href="/about/">Read my story →</a>
      </div>
    </div>
    <div class="hero-rail">
      <div class="hero-note">
        <p>
          I am the Founding Engineer at measure.coffee. Before software, I spent
          14 years in coffee, operations, and field work.
        </p>
        <p>
          Start with the people. Understand the work. Build something that
          people want to use.
        </p>
      </div>
    </div>
  </section>

  <section
    id="home-operating-history"
    class="section"
    data-od-id="home-operating-history"
  >
    <header class="section-header section-header-indigo">
      <div>
        <p class="eyebrow">How I got here</p><h2>
          Service work taught me what people need software to do.
        </h2>
      </div>
      <p>
        Coffee service, wholesale, logistics, and field leadership taught me
        that every job is a service job. Every industry is a service industry. I
        brought that perspective to engineering roles in integrations,
        automation, and product systems.
      </p>
    </header>
  </section>

  <section
    id="home-featured-work"
    class="section"
    data-od-id="home-featured-work"
  >
    <header class="section-header section-header-canary">
      <div>
        <p class="eyebrow">Featured work</p><h2 id="home-featured-work-heading">
          Work that starts with a real person and a real problem.
        </h2>
      </div>
      <p>
        Product work, engineering systems, and creative tools. Each project
        started with a practical question: what does this person need, and what
        would make it easier to get done?
      </p>
    </header>
    <ProjectRail
      projects={projects}
      railId="home-featured-projects"
      labelledBy="home-featured-work-heading"
      regionLabel="Featured projects"
    />
  </section>

  <section id="home-experience" class="section" data-od-id="home-experience">
    <header class="section-header section-header-focus">
      <div>
        <p class="eyebrow">Experience</p><h2>
          Experience in service, operations, and engineering.
        </h2>
      </div>
      <p>
        The roles changed, but the throughline stayed the same: clearer
        handoffs, better systems, and tools that help people get what they need
        done.
      </p>
    </header>
    <ExperienceTimeline entries={experience.slice(0, 4)} />
    <div class="actions">
      <a class="text-action" href="/experience/">View full experience →</a>
    </div>
  </section>

  <section
    id="home-contact"
    class="section contact-band"
    data-od-id="home-contact"
  >
    <header class="section-header section-header-indigo">
      <div>
        <p class="eyebrow">Contact</p><h2>
          Need help working through a product or systems problem?
        </h2>
      </div>
      <div>
        <p>
          I am open to conversations about products, systems, coffee, and the
          work of making something useful for the people it serves.
        </p><div class="actions">
          <a class="button button-primary" href={`mailto:${site.email}`}
            >Email Joel</a
          ><a class="text-action" href="/files/resume.pdf">Download resume ↓</a>
        </div>
      </div>
    </header>
  </section>
</BaseLayout>
