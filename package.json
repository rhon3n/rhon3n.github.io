  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.7.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
